+/* G1 evidence projection helpers: presentation only; never infer missing labels. */
+function buildExperimentEvidenceCard(result, provenance={}) {
+  const source = result?.input_evidence || result?.data_source || {};
+  const model = result?.model || {};
+  const schema = result?.feature_schema || {};
+  const labels = result?.label_evidence || {};
+  return {
+    model: model.name || provenance.model_name || '模型信息不可用',
+    algorithm: result?.algorithm || provenance.algorithm || '算法信息不可用',
+    source: source.filename || source.source_name || provenance.source_name || '数据来源不可用',
+    source_sha256: source.sha256 || provenance.source_sha256 || null,
+    source_type: source.source_type || provenance.source_type || 'unknown',
+    features: Array.isArray(schema.features) ? schema.features : [],
+    label_status: labels.status || (result?.score_only ? 'unknown' : 'not_provided'),
+    label_coverage: Number.isFinite(labels.coverage) ? labels.coverage : null,
+    truth_is_supervised: labels.status === 'verified'
+  };
+}
+
+function buildEventEvidenceRows(events, predictions, truth, time) {
+  const finite = value => Number.isFinite(Number(value)) ? Number(value) : null;
+  return (Array.isArray(events) ? events : []).map((event, index) => {
+    const start = finite(event.start ?? event.start_time);
+    const end = finite(event.end ?? event.end_time);
+    const covered = start !== null && end !== null && start <= end;
+    const indices = covered ? time.map((t,i) => Number(t) >= start && Number(t) <= end ? i : -1).filter(i => i >= 0) : [];
+    const known = indices.filter(i => truth?.[i] === 0 || truth?.[i] === 1);
+    const detected = indices.filter(i => predictions?.[i] === 1);
+    const first = detected.length ? time[detected[0]] : null;
+    return {
+      id: event.id || event.event_id || String(index + 1),
+      label: event.fault_type || event.label || '故障事件',
+      start, end, sample_count: indices.length, known_truth_count: known.length,
+      detected_count: detected.length, first_detection_time: first,
+      detection_delay: first !== null && start !== null ? first - start : null,
+      truth_coverage: indices.length ? known.length / indices.length : null,
+      status: !covered || !indices.length ? 'no_samples' :
+        !known.length ? 'unknown_truth' : detected.length ? 'detected' : 'not_detected'
+    };
+  });
+}
+
+function classifyExperimentEvidence(left, right) {
+  const reasons = [];
+  for (const key of ['algorithm','source_sha256','source_type','label_status']) {
+    if ((left?.[key] ?? null) !== (right?.[key] ?? null)) reasons.push(key);
+  }
+  const a = JSON.stringify(left?.features || []), b = JSON.stringify(right?.features || []);
+  if (a !== b) reasons.push('features');
+  return {comparable: reasons.length === 0, reasons};
+}
+
+function buildG1ReportSnapshot(result, provenance={}) {
+  const evidence = buildExperimentEvidenceCard(result, provenance);
+  const time = Array.isArray(result?.time) ? result.time : [];
+  const events = buildEventEvidenceRows(result?.events, result?.predicted_labels, result?.true_labels, time);
+  const supervised = evidence.truth_is_supervised;
+  const metrics = supervised && result?.metrics && typeof result.metrics === 'object'
+    ? result.metrics : null;
+  return {
+    schema_version: 1, generated_at: new Date().toISOString(), evidence,
+    metrics, score_semantics: 'algorithm_score_not_probability',
+    threshold: Number.isFinite(result?.decision_threshold) ? result.decision_threshold : null,
+    events, unknown_truth_preserved: !supervised,
+    result_digest: result?.result_digest || provenance.result_digest || null
+  };
+}
+
 function renderResultChart(container, result, options = {}) {
